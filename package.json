{
  "name": "aura",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:up": "docker compose -f infra/docker-compose.yml up -d",
    "db:down": "docker compose -f infra/docker-compose.yml down",
    "db:migrate": "npm run prisma:migrate -w @aura/api",
    "api": "npm run start:dev -w @aura/api",
    "desktop": "npm run dev -w @aura/desktop"
  },
  "engines": {
    "node": ">=22"
  }
}
