# Which AI to use: "ollama" (free, runs on your Mac) or "claude" (paid API)
AGENTIC_PROVIDER=ollama
# Ollama model. Use qwen3:4b on a Mac with 8 GB of memory.
OLLAMA_MODEL=qwen3:8b

# Only needed when AGENTIC_PROVIDER=claude. Get a key at https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=
AGENTIC_MODEL=claude-haiku-5-5
AGENTIC_EFFORT=medium

AGENTIC_DB=data/agentic.db

# Your first name, so Jarvis knows who it works for and can sign your replies.
AGENTIC_YOUR_NAME=

# true moves Ignore emails out of your inbox (they stay under AI/Ignore). false keeps them in the inbox.
AGENTIC_ARCHIVE_IGNORED=false

# Jarvis may send emails and move them to Trash after you say yes. false = drafts only, never deletes.
AGENTIC_ALLOW_SEND=true

# How sure the wake-word model must be before Jarvis wakes (Whisper is the backup when it isn't).
# Lower (like 0.3) wakes more easily, higher wakes by mistake less often.
AGENTIC_WAKE_THRESHOLD=0.5

# The Jarvis server for the Android app. AGENTIC_PUBLIC_URL is your secure link (for example from ngrok).
AGENTIC_PUBLIC_URL=http://localhost:8000
AGENTIC_GOOGLE_WEB_CLIENT=web_client.json
# Only these Google accounts may use your Jarvis server (comma separated). Empty = your Google test users.
AGENTIC_ALLOWED_EMAILS=

# Voice: speech-to-text model. base.en is quick; small.en hears accents better but is a bigger download.
AGENTIC_WHISPER_MODEL=base.en
