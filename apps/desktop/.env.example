# Copy to apps/desktop/.env. Every setting is optional. Never commit .env.

# Where the Aura API runs (started with `npm run api`).
AURA_API_URL=http://127.0.0.1:3000

# Wake word (free): create an account at https://console.picovoice.ai and copy
# your AccessKey here. Without it, press the hotkey below to talk.
PICOVOICE_ACCESS_KEY=
# A built-in wake word: Computer, Jarvis, Porcupine, Bumblebee, Picovoice, ...
WAKE_WORD_BUILTIN=Computer
# Or your own (for example "Hey Aura"): train it in the Picovoice Console,
# choose the "Web (WASM)" platform, download the .ppn file and put its path here.
WAKE_WORD_PATH=
# 0 to 1. Higher hears you more easily but wakes up by mistake more often.
WAKE_WORD_SENSITIVITY=0.6

# Press this anywhere to talk to Aura (Electron accelerator format).
AURA_HOTKEY=Alt+Space

# Speech to text runs on your Mac with Whisper. Downloaded once (~290 MB).
WHISPER_MODEL=Xenova/whisper-base.en

# Spoken replies use the macOS voice. Leave AURA_VOICE empty for the system
# voice, or name one from `say -v '?'` (for example Samantha).
AURA_VOICE=
AURA_SPEAK=on
