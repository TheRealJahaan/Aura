{
  "name": "@aura/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Aura for macOS: the floating orb, the wake word and the voice.",
  "main": "dist/main.js",
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs && electron .",
    "start": "electron .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src test build.mjs",
    "test": "jest",
    "test:ui": "node build.mjs && playwright test",
    "test:smoke": "node build.mjs && node test/smoke/electron.smoke.mjs"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "roots": [
      "<rootDir>/test/unit"
    ],
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "testEnvironment": "node"
  },
  "devDependencies": {
    "@picovoice/porcupine-web": "^4.0.1",
    "@picovoice/web-voice-processor": "^4.0.10",
    "@playwright/test": "1.56.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.5",
    "electron": "^44.9.3",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0"
  },
  "dependencies": {
    "@aura/shared": "^0.1.0",
    "@huggingface/transformers": "^4.3.1",
    "zod": "^4.6.7"
  }
}
