generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  avatarUrl String?
  timezone  String   @default("Asia/Kolkata")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  google        GoogleConnection?
  sessions      Session[]
  loginRequests LoginRequest[]
  conversations Conversation[]
  actions       ActionLog[]
}

// One per user: the Google account Aura acts on.
// Tokens are encrypted by the API before they are stored.
model GoogleConnection {
  id                    String   @id @default(uuid())
  userId                String   @unique
  googleSub             String   @unique
  scopes                String[]
  encryptedRefreshToken String
  connectedAt           DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// A Google sign-in that is in progress. The desktop app proves it started the
// sign-in with PKCE: it keeps a secret "verifier" and only sends its hash here.
model LoginRequest {
  id            String    @id // random; also sent to Google as the OAuth "state"
  codeChallenge String
  redirectPort  Int
  authCodeHash  String?   @unique
  userId        String?
  expiresAt     DateTime
  completedAt   DateTime?
  usedAt        DateTime?
  createdAt     DateTime  @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// A signed-in device. Only a SHA-256 hash of the token is stored, so a
// leaked database doesn't hand out working tokens.
model Session {
  id         String   @id @default(uuid())
  userId     String
  tokenHash  String   @unique
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())
  expiresAt  DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// One conversation = everything said between one "Aura listen" and the orb closing.
model Conversation {
  id        String   @id @default(uuid())
  userId    String
  startedAt DateTime @default(now())

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages Message[]
  actions  ActionLog[]

  @@index([userId, startedAt])
}

enum MessageRole {
  USER
  ASSISTANT
  TOOL
}

model Message {
  id             String      @id @default(uuid())
  // Keeps messages in the exact order they were said, even within one millisecond.
  seq            Int         @default(autoincrement())
  conversationId String
  role           MessageRole
  text           String
  // The message exactly as the AI saw it, including tool calls and tool results.
  content        Json?
  createdAt      DateTime    @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, seq])
}

enum ActionStatus {
  PENDING_CONFIRMATION
  SUCCEEDED
  FAILED
  CANCELLED
  UNDONE
}

// Every Google action Aura takes, so users can see exactly what it did (and undo it).
model ActionLog {
  id             String       @id @default(uuid())
  userId         String
  conversationId String?
  toolCallId     String?
  tool           String // e.g. "gmail_send", "calendar_create_event"
  summary        String       @default("")
  input          Json
  result         Json?
  status         ActionStatus
  error          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @default(now()) @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([conversationId, status])
}
