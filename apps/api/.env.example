# Copy this file to apps/api/.env and fill in the values. Never commit .env.
# Step-by-step instructions: docs/SETUP.md

# Postgres from infra/docker-compose.yml (port 5433, so it never clashes with
# a Postgres you may already have on 5432).
DATABASE_URL=postgresql://aura:aura@localhost:5433/aura?schema=public

# The API only listens on this Mac.
HOST=127.0.0.1
PORT=3000
PUBLIC_URL=http://127.0.0.1:3000

# From Google Cloud Console > Google Auth Platform > Clients (a "Web application"
# client with redirect URI http://127.0.0.1:3000/auth/google/callback).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Encrypts your Google refresh token in the database. Create it with:
#   openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# The AI. "ollama" is free and runs on your Mac (install from ollama.com, then
# run: ollama pull qwen3:8b). On a Mac with 8 GB of memory use qwen3:4b.
LLM_PROVIDER=ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_NUM_CTX=8192

# Optional and paid: use Claude instead of the local AI.
# Set LLM_PROVIDER=anthropic and add your own key from console.anthropic.com.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
